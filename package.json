{
  "name": "dsh-pure-chat",
  "version": "1.4.0",
  "type": "module",
  "description": "Pure chat: a selectable DSH agent preset that sends the conversation straight to the model, plus a file-writing tool (txt, md, doc, xls, pdf) and a clear-context control, with web search and fetch but without a system prompt, file or shell tools, skills, or subagents.",
  "license": "MIT",
  "author": "EonCosmos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EonCosmos/dsh-pure-chat.git"
  },
  "homepage": "https://github.com/EonCosmos/dsh-pure-chat#readme",
  "bugs": {
    "url": "https://github.com/EonCosmos/dsh-pure-chat/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "chat",
    "web-search",
    "document-export"
  ],
  "exports": {
    ".": "./index.js",
    "./preset": "./preset.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "preset.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/pure-chat.test.mjs && node test/client.test.mjs",
    "prepublishOnly": "node test/pure-chat.test.mjs && node test/client.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
