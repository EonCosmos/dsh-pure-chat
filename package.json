{
  "name": "dsh-pure-chat",
  "version": "1.2.0",
  "type": "module",
  "description": "Pure chat: a selectable DSH agent preset that sends the conversation straight to the model with web search and fetch, but without a system prompt, file or shell tools, skills, or subagents.",
  "license": "MIT",
  "author": "EonCosmos",
  "repository": {
    "type": "git",
    "url": "https://github.com/EonCosmos/dsh-pure-chat.git"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "chat",
    "web-search"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "test": "node test/pure-chat.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
